# Copy to .env and fill in. .env is gitignored.
#
# Config precedence: CLI flags > environment > TOML file > built-in defaults.
# Per-source merging is per-field, so you can sprinkle settings across all
# three layers and only override the bits that differ.

# The QQ number of the small account that NapCat will log in as.
NAPCAT_QQ=123456789

# Shared secret between NapCat and the Haskell bot. Must match on both sides.
MAX_ACCESS_TOKEN=change-me-to-a-long-random-string

# LLM (required: MAX_LLM_API_KEY — unless you set it in CLI or TOML)
MAX_LLM_API_KEY=your-deepseek-key-here

# Optional: point at a non-default TOML config.
# MAX_CONFIG=/etc/max/config.toml

# Optional overrides; defaults baked into devenv.nix / Max.Config usually suffice.
# MAX_WS_HOST=0.0.0.0
# MAX_WS_PORT=8080
# MAX_WS_PATH=/onebot
# MAX_DB_URL=postgresql://127.0.0.1:5433/max
# MAX_DB_MAX_CONNS=8
# MAX_MIGRATIONS_DIR=migrations
# MAX_IMAGES_DIR=var/images
# MAX_IMAGE_WORKERS=4    # parallel HTTP fetchers; bump for big forwards, drop if QQ CDN rate-limits
# MAX_LLM_BASE_URL=https://api.deepseek.com/v1
# MAX_LLM_MODEL=deepseek-chat
# MAX_LLM_MAX_TOKENS=2048
# MAX_LLM_TEMPERATURE=0.7
# MAX_LLM_TIMEOUT_SECONDS=120
# MAX_HISTORY_WINDOW=20  # how many recent group messages to include in prompt
# MAX_PERSONA="你是一个 QQ 群里的 AI 助手……"

# Search (Tavily) — optional. When unset the web_search tool isn't
# registered, model behaves as if it doesn't exist.
# MAX_TAVILY_API_KEY=tvly-...
# MAX_SEARCH_MAX_RESULTS=5
# MAX_SEARCH_TIMEOUT_SECONDS=30
