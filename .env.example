# Copy to .env and fill in. .env is gitignored.

# The QQ number of the small account that NapCat will log in as.
NAPCAT_QQ=123456789

# Shared secret between NapCat and the Haskell bot. Must match on both sides.
MAX_ACCESS_TOKEN=change-me-to-a-long-random-string

# Optional overrides; defaults baked into devenv.nix usually suffice.
# MAX_WS_HOST=0.0.0.0
# MAX_WS_PORT=8080
# MAX_WS_PATH=/onebot
