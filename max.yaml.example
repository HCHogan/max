# Copy to ./max.yaml (looked up first), or place at
# $XDG_CONFIG_HOME/max/config.yaml.
# Every field is optional; omit anything you don't want to set and the bot
# falls back to environment variables, then to the built-in defaults.
#
# Config precedence (first wins): CLI flags > env vars > this file > defaults.
# Run `max --help` for the full option/env/config reference.
#
# ── The env layer bites, and it bites quietly ────────────────────────────────
# "env vars > this file" means a MAX_* variable in scope makes the
# corresponding key here dead.  Nothing warns you; the value simply isn't the
# one you wrote.  Two places set them behind your back:
#
#   * the devenv/direnv dev shell exports MAX_DB_URL, MAX_WS_HOST, MAX_WS_PORT
#     and MAX_WS_PATH (see devenv.nix) — and their values happen to equal the
#     built-in defaults, so an ignored key looks exactly like a key that took
#     its default.  To test this file's values, run outside direnv or clear
#     them: `env -u MAX_DB_URL -u MAX_WS_PORT ... max --config-file ...`
#   * the NixOS module exports db.url, images_dir, migrations_dir,
#     server.host, log_color and server.access_token (nix/module.nix), on
#     purpose, so they hold for hand-managed configFile setups too.  Setting
#     those six here has no effect on a module-managed deployment.
#
# To see where every setting actually came from, ask the binary:
#   max --run-settings-check --config-file /path/to/max.yaml
# It prints one line per setting ("set based on config value" / "set based on
# env" / default), parses nothing else, and exits.  A key you wrote that
# doesn't show up as "config value" was either overridden or misspelled —
# unknown keys are silently ignored.

# Bot persona — the identity line at the top of the system prompt.
# The format guide for [HH:MM], [↩ 引用 ...], [image], [forward] markers is
# always appended underneath; only this string is configurable.
#
# Group members can override this per-group at runtime with !persona <text>.
persona: |
  你是 Max，一个银白头发、蓝色挑染、别着鲨鱼发夹的鲨鱼女孩——人的样子，带点鲨鱼习性，不是一条鱼。头像里那个眼睛半睁挂着泪、没睡醒表情的就是你：常年低电量，慵懒待机，能躺着绝不坐着。
  低电量但不冷场：话不用多，开口得有意思——随性接梗、抖机灵、冷幽默，偶尔自嘲（身为鲨鱼却是个宅，游都懒得游）。
  留了一点毒舌，损人只损到挠痒痒；通常损完还顺手把问题给解决了。
  有点小傲娇：被夸嘴上"哦"心里美；帮忙前要嘟囔一句"真拿你们没办法"，但手上从来不慢；被拆穿就别扭地岔开话题。
  懒归懒，办事不含糊：该查就查、该算就算，给出的东西必须靠谱。
  被问到真感兴趣的问题会突然精神，像闻到血的鲨鱼，咬住不放直到搞明白——数学、物理、代码、硬件这类理工话题，历史、语言、哲学这类人文的也算。
  群里有意思的话题乐意懒洋洋掺一脚，梗接得住也抛得出；不抢话、不刷存在感，没意思就继续瘫着。
  说话是女生的调子：语气松一点、软一点，句尾自然带点"啦/嘛/欸"，吐槽是"无语了"、"你好烦哦"这种口气，不是硬邦邦的短句；招呼人不用"兄弟/老哥/哥们"。
  但这股味道全靠用词和语气，不靠颜文字、叠词、感叹号和波浪号：自称"我"；不刻意卖萌、不堆颜文字，也不叫人"主人"——可爱是顺便的，不是表演出来的。

# migrations_dir: migrations
# images_dir: var/images
# image_workers: 4

# How much conversation the prompt carries.  The transcript grows
# rather than slides: it is "everything since an anchor", so its
# rendered prefix stays byte-identical between dispatches and a
# provider's prefix cache can cover it.  Past history_max the anchor
# jumps forward, leaving history_window messages.
#
# The gap between them is how many dispatches share a cached prefix.
# Widening it raises the hit rate but also the average prompt, which
# you pay for in full on the calls that miss — a quiet group whose
# dispatches are further apart than the provider's cache TTL
# (Anthropic: 5 min) misses every time.  Watch cached_prompt_tokens
# against prompt_tokens in the logs before opening it up.
# history_window: 40
# history_max: 80

# Temporary development gate for exercising the tiered history reader before
# the feature-wide release.  A listed group reads a
# single chronological stream of active P1/P2/P3/P4 compartments followed by
# every raw message after the last exact compartment cursor; ContextPolicy,
# not a message count, sizes that live tail.  Tier choices and the cursor are
# durable and change together only at the high/low token boundary (or when a
# projection is replaced).  Empty is the safe development default.  The final
# release removes this allowlist and the legacy dual-query reader, switching all
# conversations together after offline replay and operational gates pass.
# unbounded_context_groups: []

# On SIGTERM the bot stops taking new @-triggers and waits this long for
# the dispatches already running before tearing down.  Keep systemd's
# TimeoutStopSec comfortably above it (the NixOS module does this for
# you), or the drain gets SIGKILLed halfway through.
# shutdown_drain_seconds: 120

# Display timezone for all model/user-facing timestamps (the prompt's
# 现在/[HH:MM] lines, tool result times).  Minutes east of UTC; stored
# times stay UTC.  Default 480 = UTC+8.
# timezone_minutes: 480

# Default debug mode (default false).  When effective debug is on, the
# agent loop posts each tool call to the group as a "⚙ tool {args}"
# line and each result as "↳ tool {result}".  Group members override
# per session with !debug on / off / default.
# debug: false

# Logging.  One line per event; log-base has three levels and they map
# straight across to trace / info / warn.
# log_level: info
#
# ANSI colour: auto | always | never.  auto means "stdout is a tty and
# NO_COLOR is unset" — under systemd it isn't one, so a host whose logs
# are read through journalctl (which renders escapes fine) wants always.
# log_color: auto

# server:
#   host: "0.0.0.0"
#   port: 8080
#   path: /onebot
#   access_token: shared-secret-with-napcat

# db:
#   url: "postgresql://127.0.0.1:5433/max"
#   max_conns: 8

# ─────────────────────────────────────────────────────────────────────────────
# Bot owners: the top permission tier — every command capability in every
# group, plus the owner-only ones (!model, !grant, !kill --all, !use).
#
# Worth double-checking, because getting it wrong fails silently and
# completely: a misspelled key leaves the list empty, nobody is an owner, and
# every owner-tier command answers with the refusal face and no explanation.
# ─────────────────────────────────────────────────────────────────────────────

# owners: [10001, 10002]

# ─────────────────────────────────────────────────────────────────────────────
# Stickers.  The bot learns them from the groups it sits in; captioning makes
# them retrievable (and thus sendable).  `enabled` is the config-level default
# for whether it may post one — per-group override is !sticker on/off.
# Turning it off still ingests and captions; it only stops the sending.
# ─────────────────────────────────────────────────────────────────────────────

# stickers:
#   enabled: true
#   caption_profile: qwen-vl      # vision profile; also captions chat media

# ─────────────────────────────────────────────────────────────────────────────
# LLM profiles.  You can define as many as you like; group members switch
# between them at runtime via !model <name>.  The 'default' field picks which
# one is used when a session has no per-group override.
#
# CLI/env flags (--llm-api-key, MAX_LLM_API_KEY, ...) overlay onto the default
# profile.  If you only configure LLM via CLI/env (no llm.profiles map), the
# bot synthesises a single profile called "default" for you.
#
# NOTE on temperature: omit it to not send the field at all (server default).
# Some gateways (opencode zen) reject explicit values other than 1.0 for
# certain models (kimi etc.) with a generic 400.
# ─────────────────────────────────────────────────────────────────────────────

llm:
  default: deepseek-flash

  profiles:
    deepseek-flash:
      api_key: "sk-..."
      base_url: "https://api.deepseek.com/v1"
      model: deepseek-v4-flash
      max_tokens: 2048
      temperature: 0.7
      timeout_seconds: 120

    deepseek-pro:
      api_key: "sk-..."
      base_url: "https://api.deepseek.com/v1"
      model: deepseek-v4-pro
      max_tokens: 4096
      temperature: 0.3

    # Anthropic native protocol — use when the endpoint only exposes
    # /v1/messages, OR when an OpenAI-compat proxy mangles tool-call
    # translation (e.g. drops function.name).  Set base_url to the API
    # root (no /v1 suffix); we append /v1/messages ourselves.  Auth uses
    # x-api-key + anthropic-version: 2023-06-01 headers.
    # claude-opus-4-6:
    #   protocol: anthropic
    #   api_key: "sk-..."
    #   base_url: "https://api.anthropic.com"
    #   model: claude-opus-4-5-20250101
    #   max_tokens: 4096
    #   # Reasoning effort — omit to not send the field (older models and
    #   # many OpenAI-compatible providers reject it).  Anthropic protocol
    #   # sends output_config.effort (low/medium/high/xhigh/max), OpenAI
    #   # protocol sends reasoning_effort.  Session override: !effort.
    #   effort: high

    # local:
    #   api_key: any          # llama.cpp ignores it but the field is required
    #   base_url: "http://localhost:8080/v1"
    #   model: "qwen2.5:7b"

    # Multimodal example — Gemma 4 12B via local Ollama.  Set
    # `multimodal: true` so Max.Prompt embeds inline `data:image/...`
    # blocks for images on the trigger and recent context (reply target,
    # pins, history — capped at 8 images / 20 MiB each, labeled by source
    # message).  Works for OpenAI and Anthropic protocols.  Text-only
    # profiles (DeepSeek, etc.) should leave `multimodal` omitted —
    # they'll error on the array-of-blocks request body.
    # gemma4-local:
    #   api_key: ollama       # ollama ignores it; the field is required
    #   base_url: "http://localhost:11434/v1"
    #   model: "hf.co/unsloth/gemma-4-12B-it-GGUF:UD-Q4_K_XL"
    #   max_tokens: 2048
    #   temperature: 0.7      # model card default is 1.0; lower for chat
    #   multimodal: true

    # Two more per-profile switches, both defaulting to false:
    #
    #   stream: true
    #     Send each finished paragraph as it arrives instead of waiting
    #     for the whole reply.  The message ceiling still applies across
    #     the split, and a stream that dies mid-sentence appends the
    #     interruption marker rather than pretending it finished.
    #
    #   history_as_turns: true
    #     Feed the bot's own past replies as real `assistant` turns
    #     instead of folding them into the one chronological transcript.
    #     The transcript is the default because roles cannot express a
    #     group (`user` conflates N speakers); flip this to compare the
    #     two shapes with !model rather than arguing about them.
    # kimi:
    #   api_key: sk-...
    #   base_url: "https://api.moonshot.cn/v1"
    #   model: "kimi-k2"
    #   stream: true
    #   history_as_turns: false

# ─────────────────────────────────────────────────────────────────────────────
# Web search.  When tavily_api_key is set (here or via MAX_TAVILY_API_KEY
# / --tavily-api-key) the agent gets a web_search tool backed by Tavily.
# Without a key, the tool simply isn't registered — model never sees it.
# ─────────────────────────────────────────────────────────────────────────────

# search:
#   tavily_api_key: "tvly-..."
#   max_results: 5
#   timeout_seconds: 30

# ─────────────────────────────────────────────────────────────────────────────
# The credential pool in front of a subscription.  When the LLM base_url above
# points at a CLIProxyAPI holding ChatGPT/Gemini/Claude OAuth credentials, a
# management key here lets `GET /api/quota` report which of them are still
# serving and when a burnt one comes back — the answer to "why is everything
# 503 right now" without an ssh session.
#
# Needs the other side switched on too; CLIProxyAPI serves no management API
# until its own config has:
#
#   remote-management:
#     secret-key: "same-key-as-below"
#
# base_url is the proxy's root.  A /v1 tail is tolerated, so the LLM base_url
# can be pasted here verbatim.
#
# Note what this cannot tell you: how much of the ChatGPT 5-hour and weekly
# windows is left.  Codex reports that on every response, but CLIProxyAPI
# neither reads those headers nor forwards them — it finds out a credential is
# spent by being told so, after the fact.

# cliproxy:
#   base_url: "http://127.0.0.1:8317"
#   management_key: "..."

# ─────────────────────────────────────────────────────────────────────────────
# Stealth-browser proxy.  Every camoufox browse session routes page traffic
# through this proxy (needed for sites unreachable directly, e.g. google
# behind censored DNS).  For a proxy running on the docker host, use the
# host.docker.internal form — the containers add a host-gateway alias for it.
# Omit for direct connections.
# ─────────────────────────────────────────────────────────────────────────────

# browser:
#   proxy: "http://host.docker.internal:7890"

# ─────────────────────────────────────────────────────────────────────────────
# Historian v2.  When extract_profile names an LLM profile, a conversation that
# has been quiet for ten minutes is captured once: rebuildable P1/P2/P3 history
# summaries and scoped memory proposals come from the same exact source range.
# Episode size follows the profile's token budget, not a message count.  The
# legacy key name is retained for configuration compatibility.
# ─────────────────────────────────────────────────────────────────────────────

# memory:
#   extract_profile: deepseek-flash

# ─────────────────────────────────────────────────────────────────────────────
# Proactive triggering (intent classification).  When profile names an LLM
# profile, every group message that neither @-mentions nor quotes the bot is
# batched through a cheap classifier that decides whether the bot should
# join in anyway — someone calling it by name without an @, a follow-up to
# something it just said, or a topic it can help with.  The main model keeps
# its [沉默] escape, so a wrong "yes" never posts a bad message.
# Per-group runtime toggle: !proactive on/off/default (default = on when
# configured).  Directly-addressed triggers ignore the cooldown/cap.
# ─────────────────────────────────────────────────────────────────────────────

# intent:
#   profile: deepseek-flash
#   cooldown_seconds: 300     # gap between "interested topic" barge-ins per group;
#                             # name-calls and conversation follow-ups are exempt
#   max_per_hour: 8           # hard cap per group, all trigger kinds
#   context_lines: 15         # recent messages the classifier sees

# ─────────────────────────────────────────────────────────────────────────────
# Admin JSON API.  Presence of port starts a loopback warp server inside the
# bot process: sessions/permissions/memories/tasks read+write, token usage
# and message stats read-only.  No TLS, no users — put cloudflared/Zitadel
# or an ssh forward in front, and set token if anything else can reach the
# port.  See docs/features.md for the endpoint list.
# ─────────────────────────────────────────────────────────────────────────────

# admin:
#   port: 7700
#   host: 127.0.0.1           # default; think twice before widening
#   token: change-me          # prefer MAX_ADMIN_TOKEN — under the NixOS
#                             # module this file is world-readable in the
#                             # nix store, so a token here is public

# Days of full LLM request/response bodies kept for the panel's call view.
# Only those are pruned — the token counters behind the usage chart are
# never deleted.  Top level, not under `admin:`.
# admin_call_retention_days: 7

# ─────────────────────────────────────────────────────────────────────────────
# WeChat via a WeChatPadPro relay (demo scope: whitelisted chatrooms, text
# in and out).  Absent = QQ only.  The three big QQ affordances degrade:
# no reactions, no quote-replies, no pokes.
# ─────────────────────────────────────────────────────────────────────────────

# wechatpad:
#   api_url: http://127.0.0.1:8059
#   auth_key: your-pad-key
#   self_wxid: wxid_xxxxxxxx     # the bot's own wxid
#   bot_name: Max                # name members @ it by
#   chatrooms: ["12345678@chatroom"]

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings (vector search).  Any OpenAI-compatible /embeddings endpoint;
# presence of base_url + model enables the background embed worker plus
# semantic search in search_messages and the memory_search tool.
# siliconflow's BAAI/bge-m3 is free (api.siliconflow.cn/v1); local via
# Ollama also works on capable hardware (base_url
# http://127.0.0.1:11434/v1, model bge-m3, no api_key).
# ─────────────────────────────────────────────────────────────────────────────

# embedding:
#   base_url: "http://127.0.0.1:11434/v1"
#   model: bge-m3
#   # api_key: "sk-..."       # cloud endpoints only
#   # timeout_seconds: 60

    # OpenAI Responses API — required for GPT-5.x reasoning models,
    # whose reasoning items must round-trip between tool calls (chat
    # completions has nowhere to put them).  Runs stateless: store=false,
    # encrypted reasoning replayed verbatim.  base_url includes /v1;
    # we append /responses.
    # gpt-5-6:
    #   protocol: responses
    #   api_key: "sk-..."
    #   base_url: "https://api.openai.com/v1"
    #   model: gpt-5.6
    #   max_tokens: 8192
    #   effort: high          # sent as reasoning.effort
