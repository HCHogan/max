            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "type": "object"
          },
          "host": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "timeout_seconds": {
            "default": null,
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "host",
          "profile",
          "command"
        ],
        "title": "ExecRunParams",
        "type": "object"
      },
      "read_only": false,
      "summary": "Run a bounded command using a configured target profile"
