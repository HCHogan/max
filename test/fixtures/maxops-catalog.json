      "kind": "job_submission",
      "minimum_protocol_version": 2,
      "name": "exec.run",
      "params_schema": {
        "$defs": {
          "CommandSpec": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "argv": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "argv"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "script": {
                    "type": "string"
                  }
                },
                "required": [
                  "script"
                ],
                "type": "object"
              }
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "command": {
            "$ref": "#/$defs/CommandSpec"
          },
