#!/usr/bin/env bash
# Checks that the pinned pi keeps what a background agent rests on, with
# max-pi.sh and max-agent.ts, against a fake /llm (check-pi-job.js). pi's
# extension API has no version: run this after moving the llm-agents pin,
# or after changing max-agent.ts, max-pi.sh or agent-system.md.
# Runs in the dev shell, which has Node and jq; PI=path/to/pi runs another
# pi. It checks pi and the plugin, not maxx agent or maxx units: those have
# the NixOS test, checks.<system>.jobs.
set -euo pipefail
cd "$(dirname "$0")/.."

pi=${PI:-$(nix build --no-link --print-out-paths --inputs-from . 'llm-agents#pi')/bin/pi}
node scripts/check-pi-job.js "$pi"
