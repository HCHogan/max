#!/usr/bin/env bash
# Checks that the pinned pi keeps a job's contract with the host, with
# max-pi.sh and max-job.ts, against a fake host (check-pi-job.js). pi's
# extension API has no version: run this after moving the llm-agents pin,
# or after changing max-job.ts, max-pi.sh or the job part of client.js.
# Runs in the dev shell, which has Node and jq; PI=path/to/pi runs another
# pi. It checks pi, not the host: the host's side has max's tests.
set -euo pipefail
cd "$(dirname "$0")/.."

pi=${PI:-$(nix build --no-link --print-out-paths --inputs-from . 'llm-agents#pi')/bin/pi}
node scripts/check-pi-job.js "$pi"
