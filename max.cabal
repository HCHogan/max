cabal-version:      3.0
name:               max
version:            0.1.0.0
synopsis:           QQ group chat agent over OneBot 11 (NapCatQQ)
author:             Hank Hogan
maintainer:         hankchogan@gmail.com
build-type:         Simple

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages

common lang
    default-language:   GHC2024
    default-extensions:
        DuplicateRecordFields
        LambdaCase
        OverloadedRecordDot
        OverloadedStrings
        StrictData

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        OneBot.Action
        OneBot.Event
        OneBot.Segment
        OneBot.Server
        OneBot.Types
        Max.Command.Dispatcher
        Max.Command.Parser
        Max.Command.Types
        Max.Config
        Max.DB.Connection
        Max.DB.Files
        Max.DB.Forward
        Max.DB.History
        Max.DB.Message
        Max.DB.Migrations
        Max.DB.Session
        Max.Effects.Agent
        Max.Effects.Blob
        Max.Effects.Http
        Max.Effects.LLM
        Max.Effects.NapCat
        Max.Effects.Tools
        Max.Files
        Max.Forward
        Max.Handler
        Max.Images
        Max.Prompt
        Max.Sandbox.Docker
        Max.Sandbox.Registry
        Max.Session
        Max.Session.Types
        Max.Tasks
        Max.Tools
        Max.Tools.Files
        Max.Tools.Sandbox
        Max.Util
    build-depends:
        , aeson               >= 2.2  && < 2.3
        , base                >= 4.20 && < 5
        , base16-bytestring   >= 1.0  && < 1.1
        , base64-bytestring   >= 1.2  && < 1.3
        , bytestring          >= 0.12 && < 0.13
        , case-insensitive    >= 1.2  && < 1.3
        , containers          >= 0.7  && < 0.9
        , crypton-connection  >= 0.3  && < 0.5
        , crypton-x509-system >= 1.6  && < 1.7
        , cryptohash-sha256   >= 0.11 && < 0.12
        , directory           >= 1.3  && < 1.4
        , effectful           >= 2.5  && < 2.6
        , effectful-core      >= 2.5  && < 2.6
        , effectful-postgresql >= 0.1  && < 0.2
        , filepath            >= 1.5  && < 1.6
        , http-client         >= 0.7  && < 0.8
        , http-client-tls     >= 0.3  && < 0.4
        , http-types          >= 0.12 && < 0.13
        , log-effectful       >= 1.0  && < 1.1
        , megaparsec          >= 9.5  && < 9.8
        , optparse-applicative >= 0.18 && < 0.20
        , postgresql-simple   >= 0.7  && < 0.8
        , process             >= 1.6  && < 1.7
        , resource-pool       >= 0.4  && < 0.5
        , scientific          >= 0.3  && < 0.4
        , stm                 >= 2.5  && < 2.6
        , text                >= 2.1  && < 2.2
        , time                >= 1.12 && < 1.15
        , tls                 >= 2.0  && < 3.0
        , tomland             >= 1.3  && < 1.4
        , uuid                >= 1.3  && < 1.4
        , websockets          >= 0.13 && < 0.14

executable max-bot
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        , base                 >= 4.20 && < 5
        , effectful            >= 2.5  && < 2.6
        , effectful-postgresql >= 0.1  && < 0.2
        , log-base             >= 0.12 && < 0.13
        , log-effectful        >= 1.0  && < 1.1
        , max
        , stm                  >= 2.5  && < 2.6
        , text                 >= 2.1  && < 2.2
        , unix                 >= 2.8  && < 2.9
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

executable ws
    import:             warnings, lang
    hs-source-dirs:     ws
    main-is:            Main.hs
    build-depends:
        , base
        , websockets
        , text
        , stm
        , mtl
