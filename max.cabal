cabal-version:      3.0
name:               max
version:            0.12.0
synopsis:           QQ group chat agent over OneBot 11 (NapCatQQ)
license:            MIT
license-file:       LICENSE
author:             Hank Hogan
maintainer:         hankchogan@gmail.com
copyright:          (c) 2026 Hank Hogan
build-type:         Simple

-- The admin panel, baked into the binary by 'Max.Admin.staticAssets'
-- (file-embed).  GHC records each file as a dependency of Max.Admin
-- and would recompile on a change — but cabal decides whether to call
-- GHC at all from its own monitored set, which covers hs-source-dirs
-- and these fields only.  Without them, editing app.css leaves cabal
-- reporting "Up to date" and the old bytes stay embedded, which is a
-- silent stale deploy rather than a build error.
extra-source-files:
    docs/architecture.md
    docs/features.md
    skills/*.md
    static/*.html
    static/*.js
    static/*.css
    static/vendor/*.js
    static/vendor/*.css
    static/vendor/*.woff2

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages

common lang
    default-language:   GHC2024
    default-extensions:
        DuplicateRecordFields
        LambdaCase
        OverloadedRecordDot
        OverloadedStrings
        StrictData

library
    import:           warnings, lang
    hs-source-dirs:   src
    exposed-modules:
        OneBot.Action
        OneBot.Event
        OneBot.Segment
        OneBot.Server
        OneBot.Types
        Max.Admin
        Max.Bilibili
        Max.Browser.Docker
        Max.Browser.Registry
        Max.BuildInfo
        Max.Command.Dispatcher
        Max.Command.Help
        Max.Command.Parser
        Max.Command.Permission
        Max.Command.Types
        Max.CliProxy
        Max.Config
        Max.MCP.Client
        Max.DB.Calls
        Max.DB.Connection
        Max.DB.FetchQueue
        Max.DB.Files
        Max.DB.Forward
        Max.DB.History
        Max.DB.Memory
        Max.DB.Message
        Max.DB.Permissions
        Max.DB.PlatformIds
        Max.DB.Migrations
        Max.DB.Reminder
        Max.DB.Session
        Max.DB.Stickers
        Max.DB.Usage
        Max.Effects.Agent
        Max.Effects.Blob
        Max.Effects.Http
        Max.Effects.LLM
        Max.Effects.NapCat
        Max.Effects.Tools
        Max.Embedder
        Max.Embedding
        Max.Env
        Max.Faces
        Max.FetchQueue
        Max.Files
        Max.Forward
        Max.Handler
        Max.Http.Stream
        Max.ImagePrep
        Max.Images
        Max.Intent
        Max.LLM.Stream
        Max.Log
        Max.LogBuffer
        Max.MediaCaption
        Max.MemoryExtract
        Max.Platform
        Max.Prompt
        Max.Reminder
        Max.Render
        Max.Reply
        Max.ReplySend
        Max.Roster
        Max.Sandbox.Docker
        Max.Sandbox.Registry
        Max.Session
        Max.Session.Types
        Max.Shutdown
        Max.Skills
        Max.Sticker
        Max.Stickers
        Max.Tasks
        Max.Time
        Max.Toolset
        Max.Tools
        Max.Tools.Bilibili
        Max.Tools.Browser
        Max.Tools.Files
        Max.Tools.Group
        Max.Tools.Images
        Max.Tools.Memory
        Max.Tools.Pins
        Max.Tools.Reminder
        Max.Tools.Sandbox
        Max.Tools.Search
        Max.Tools.Skills
        Max.Tools.Stickers
        Max.Tools.Video
        Max.Util
        Max.Wechatpad
        Max.Wreq
    other-modules:    Paths_max
    autogen-modules:  Paths_max
    build-depends:
        , aeson               >= 2.2  && < 2.4
        , base                >= 4.20 && < 5
        , base16-bytestring   >= 1.0  && < 1.1
        , base64-bytestring   >= 1.2  && < 1.3
        , bytestring          >= 0.12 && < 0.13
        , Cabal               >= 3.12 && < 3.16
        , case-insensitive    >= 1.2  && < 1.3
        , containers          >= 0.7  && < 0.9
        , cron                >= 0.7  && < 0.8
        , crypton-connection  >= 0.3  && < 0.5
        , crypton-x509-system >= 1.6  && < 2.0
        , cryptohash-sha256   >= 0.11 && < 0.12
        , directory           >= 1.3  && < 1.4
        , effectful           >= 2.5  && < 2.7
        , effectful-core      >= 2.5  && < 2.7
        , effectful-postgresql >= 0.1  && < 0.2
        , filepath            >= 1.5  && < 1.6
        , http-client         >= 0.7  && < 0.8
        , http-client-tls     >= 0.3  && < 0.5
        , http-types          >= 0.12 && < 0.13
        , lens                >= 5.2  && < 5.4
        , log-base            >= 0.12 && < 0.13
        , log-effectful       >= 1.0  && < 1.1
        , megaparsec          >= 9.5  && < 9.9
        , autodocodec         >= 0.4  && < 0.6
        , path                >= 0.9  && < 0.10
        , path-io             >= 1.8  && < 1.10
        , opt-env-conf        >= 0.15 && < 0.17
        , postgresql-simple   >= 0.7  && < 0.8
        , process             >= 1.6  && < 1.7
        , random              >= 1.2  && < 1.4
        , resource-pool       >= 0.4  && < 0.6
        , scientific          >= 0.3  && < 0.4
        , stm                 >= 2.5  && < 2.6
        , template-haskell    >= 2.22 && < 2.24
        , text                >= 2.1  && < 2.2
        , time                >= 1.12 && < 1.17
        , vector              >= 0.13 && < 0.14
        , tls                 >= 2.0  && < 3.0
        , uuid                >= 1.3  && < 1.4
        , file-embed          >= 0.0.15 && < 0.1
        , wai                 >= 3.2  && < 3.3
        , warp                >= 3.3  && < 3.5
        , websockets          >= 0.13 && < 0.14
        , wreq                >= 0.5  && < 0.6
        , wreq-effectful      >= 0.1  && < 0.2

executable max
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        , base                 >= 4.20 && < 5
        , containers           >= 0.7  && < 0.9
        , effectful            >= 2.5  && < 2.7
        , effectful-postgresql >= 0.1  && < 0.2
        , log-effectful        >= 1.0  && < 1.1
        , max
        , stm                  >= 2.5  && < 2.6
        , text                 >= 2.1  && < 2.2
        , time                 >= 1.12 && < 1.17
        , unix                 >= 2.8  && < 2.9
        , wreq-effectful       >= 0.1  && < 0.2
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Offline replay of intent-classifier fixtures against a live LLM
-- profile; see eval/README.md for the journalctl → fixture → replay
-- workflow.
executable max-intent-eval
    import:           warnings, lang
    hs-source-dirs:   eval
    main-is:          Main.hs
    build-depends:
        , aeson                >= 2.2  && < 2.4
        , base                 >= 4.20 && < 5
        , bytestring           >= 0.12 && < 0.13
        , effectful            >= 2.5  && < 2.7
        , log-effectful        >= 1.0  && < 1.1
        , max
        , opt-env-conf         >= 0.15 && < 0.17
        , text                 >= 2.1  && < 2.2
        , wreq-effectful       >= 0.1  && < 0.2
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite max-test
    import:             warnings, lang
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Spec.hs
    other-modules:
        Max.AdminSpec
        Max.CliProxySpec
        Max.BilibiliSpec
        Max.Command.ParserSpec
        Max.Command.PermissionSpec
        Max.HandlerSpec
        Max.IntentSpec
        Max.LLM.StreamSpec
        Max.LogSpec
        OneBot.EventSpec
        OneBot.SegmentSpec
        Max.RenderSpec
        Max.ReplySpec
        Max.ReplySendSpec
        Max.SessionSpec
        Max.ShutdownSpec
        Max.SkillsSpec
        Max.TasksSpec
        Max.Effects.AgentSpec
        Max.Effects.LLMSpec
        Max.MCP.ClientSpec
        Max.PlatformSpec
        Max.MemoryExtractSpec
        Max.PromptSpec
        Max.Sandbox.DockerSpec
        Max.Tools.FilesSpec
        Max.WreqSpec
    build-depends:
        , aeson           >= 2.2  && < 2.4
        , base            >= 4.20 && < 5
        , bytestring      >= 0.12 && < 0.13
        , containers      >= 0.7  && < 0.9
        , hspec           >= 2.11 && < 2.12
        , stm             >= 2.5  && < 2.6
        , log-base        >= 0.12 && < 0.13
        , max
        , text            >= 2.1  && < 2.2
        , time            >= 1.12 && < 1.17
        , vector          >= 0.13 && < 0.14
    build-tool-depends: hspec-discover:hspec-discover
    ghc-options:        -threaded -rtsopts -with-rtsopts=-N

-- DB-touching tests against a real Postgres.  Skipped (exit 0) when
-- MAX_TEST_DB_URL is unset.  See test-db/README.md for setup, or just
-- run `devenv up` and `export MAX_TEST_DB_URL=postgresql://.../max_test`.
test-suite max-test-db
    import:             warnings, lang
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test-db
    main-is:            Main.hs
    other-modules:
        Helpers
        Max.DB.FetchQueueSpec
        Max.DB.SessionSpec
        Max.DB.HistorySpec
        Max.DB.MessageSpec
        Max.PromptIntegrationSpec
    build-depends:
        , base                 >= 4.20 && < 5
        , containers           >= 0.7  && < 0.9
        , hspec                >= 2.11 && < 2.12
        , log-base             >= 0.12 && < 0.13
        , log-effectful        >= 1.0  && < 1.1
        , max
        , effectful            >= 2.5  && < 2.7
        , effectful-postgresql >= 0.1  && < 0.2
        , postgresql-simple    >= 0.7  && < 0.8
        , text                 >= 2.1  && < 2.2
        , time                 >= 1.12 && < 1.17
    ghc-options:        -threaded -rtsopts -with-rtsopts=-N
