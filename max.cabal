        , warp                >= 3.3  && < 3.5
        , websockets          >= 0.13 && < 0.14

executable max
    import:           warnings, lang
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        , base                 >= 4.20 && < 5
        , containers           >= 0.7  && < 0.9
        , effectful            >= 2.5  && < 2.7
        , effectful-postgresql >= 0.1  && < 0.2
        , log-effectful        >= 1.0  && < 1.1
        , max
        , stm                  >= 2.5  && < 2.6
        , text                 >= 2.1  && < 2.2
        , time                 >= 1.12 && < 1.17
        , unix                 >= 2.8  && < 2.9
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Deterministic renderer for docs/prompt-flow.md.  It exercises the pure
-- seams between the Prompt, Agent and LLM effects; no DB or network needed.
executable max-prompt-flow
    import:           warnings, lang
    hs-source-dirs:   prompt-flow
    main-is:          Main.hs
    build-depends:
        , base       >= 4.20 && < 5
        , directory  >= 1.3  && < 1.4
        , max
        , text       >= 2.1  && < 2.2

-- Offline replay of intent-classifier fixtures against a live LLM
-- profile; see eval/README.md for the journalctl → fixture → replay
-- workflow.
executable max-intent-eval
    import:           warnings, lang
    hs-source-dirs:   eval
    main-is:          Main.hs
    build-depends:
        , aeson                >= 2.2  && < 2.4
        , base                 >= 4.20 && < 5
        , bytestring           >= 0.12 && < 0.13
        , effectful            >= 2.5  && < 2.7
        , log-effectful        >= 1.0  && < 1.1
        , max
        , opt-env-conf         >= 0.15 && < 0.17
        , text                 >= 2.1  && < 2.2
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

-- Offline release gate for Historian quality/cost and the deliberately
-- disabled direct-turn auto-recall policy.
executable max-context-eval
    import:           warnings, lang
    hs-source-dirs:   context-eval
    main-is:          Main.hs
    build-depends:
        , aeson                >= 2.2  && < 2.4
        , base                 >= 4.20 && < 5
        , bytestring           >= 0.12 && < 0.13
        , effectful            >= 2.5  && < 2.7
        , log-effectful        >= 1.0  && < 1.1
        , max
        , opt-env-conf         >= 0.15 && < 0.17
        , text                 >= 2.1  && < 2.2
        , time                 >= 1.12 && < 1.16
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

