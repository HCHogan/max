cabal-version:      3.0
name:               max
version:            0.12.0
synopsis:           QQ group chat agent over OneBot 11 (NapCatQQ)
license:            MIT
license-file:       LICENSE
author:             Hank Hogan
maintainer:         hankchogan@gmail.com
copyright:          (c) 2026 Hank Hogan
build-type:         Simple

-- The admin panel, baked into the binary by 'Max.Admin.staticAssets'
-- (file-embed).  GHC records each file as a dependency of Max.Admin
-- and would recompile on a change — but cabal decides whether to call
-- GHC at all from its own monitored set, which covers hs-source-dirs
-- and these fields only.  Without them, editing app.css leaves cabal
-- reporting "Up to date" and the old bytes stay embedded, which is a
-- silent stale deploy rather than a build error.
extra-source-files:
    context-eval/README.md
    context-eval/fixtures/*.jsonl
    docs/architecture.md
    docs/features.md
    docs/prompt-flow.md
    skills/*.md
    static/*.html
    static/*.js
    static/*.css
    static/vendor/*.js
    static/vendor/*.css
    static/vendor/*.woff2

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages

common lang
    default-language:   GHC2024
    default-extensions:
        DuplicateRecordFields
        LambdaCase
        OverloadedRecordDot
        OverloadedStrings
        StrictData

