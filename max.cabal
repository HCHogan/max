cabal-version:      3.0
name:               max
version:            0.17.3
synopsis:           Multi-platform group agent with durable context and memory
description:        A multi-platform group agent with a canonical message ledger,
                    durable task and turn execution, scoped memory, and typed tools.
category:           Network
license:            MIT
license-file:       LICENSE
author:             Hank Hogan
maintainer:         hankchogan@gmail.com
copyright:          (c) 2026 Hank Hogan
build-type:         Simple

-- The admin panel, baked into the binary by 'Max.Admin.staticAssets'
-- (file-embed).  GHC records each file as a dependency of Max.Admin
-- and would recompile on a change — but cabal decides whether to call
-- GHC at all from its own monitored set, which covers hs-source-dirs
-- and these fields only.  Without them, editing app.css leaves cabal
-- reporting "Up to date" and the old bytes stay embedded, which is a
-- silent stale deploy rather than a build error.
extra-source-files:
    .env.example
    .github/workflows/*.yml
    LICENSE
    README.md
    scripts/test-task-upgrade.sh
    test-db/fixtures/task-upgrade-before.sql
    test-db/fixtures/task-upgrade-after.sql
    test-db/fixtures/browser-upgrade-after.sql
    assets/codesnap/*.tmTheme
    browser-image/Dockerfile
    browser-image/build.sh
    browser-image/*.patch
    browser-image/*.ts
    browser-image/*.mjs
    bridge/imsg/*.go
    bridge/imsg/*.m
    bridge/imsg/go.mod
    bridge/imsg/README.md
    bridge/imsg/*.example
    bridge/wechat/*.go
    bridge/wechat/go.mod
    bridge/wechat/README.md
    cabal.project
    context-eval/README.md
    context-eval/fixtures/*.jsonl
    devenv.nix
    docs/architecture.md
    docs/adr/*.md
    docs/features.md
    docs/development.md
    docs/platforms.md
    docs/prompt-flow.md
    docs/runbooks/*.md
    docker-compose.yml
    eval/README.md
    eval/fixtures/*.jsonl
    flake.lock
    flake.nix
    max.yaml.example
    migrations/*.sql
    nix/*.nix
    nix/tests/*.nix
    nix/tests/*.py
    sandbox-image/Dockerfile
    sandbox-image/build.sh
    sandbox-image/nix.conf
    scripts/*.sh
    scripts/*.mjs
    scripts/*.hs
    skills/*.md
    static/*.html
    static/*.js
    static/*.css
    static/vendor/*.js
    static/vendor/*.css
    static/vendor/*.woff2

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wunused-packages

common lang
    default-language:   GHC2024
    default-extensions:
        DuplicateRecordFields
        LambdaCase
        OverloadedRecordDot
        OverloadedStrings
        StrictData

