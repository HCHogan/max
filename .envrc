#!/usr/bin/env bash

# Interactive activation is owned by `devenv shell`, which rebuilds the
# environment in the background. Keep this file inert so a global direnv
# hook does not load a second environment or shadow the native devenv CLI
# with the flake compatibility wrapper.
# For activation on cd, configure `devenv hook zsh` and run `devenv allow`.
# See README.md. CI can still use `nix develop --impure`.
