{
  "db_name": "PostgreSQL",
  "query": "\n            select s.id, s.conversation_id, concat_ws(E'\\n', nullif(s.title, ''), s.p1) as \"text!\"\n            from summaries s\n            where s.id = any($2) and s.status = 'active'\n              and not exists (select 1 from summary_embeddings e\n                              where e.summary_id = s.id and e.model = $1)\n            order by s.id desc\n            ",
