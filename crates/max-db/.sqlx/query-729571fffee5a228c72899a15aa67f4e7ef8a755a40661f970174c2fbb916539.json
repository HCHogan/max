{
  "db_name": "PostgreSQL",
  "query": "\n        select i.id, i.principal_id\n        from identities i join principals p on p.id = i.principal_id\n        where p.merged_into = $2 and i.id <> $3\n          and exists (\n              select 1 from messages m where m.endpoint_id = $1 and m.sender_identity_id = i.id\n          )\n        limit 1\n        ",
