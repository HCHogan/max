{
  "db_name": "PostgreSQL",
  "query": "\n        select m.id, m.nodes as \"nodes: Json<Vec<Node>>\",\n               array(select ordinal from message_media where message_id = m.id) as \"done!\"\n        from messages m\n        where m.received_at >= $1\n          and jsonb_path_exists(m.nodes, '$[*] ? (@.type == \"media\" && exists(@.media.remote))')\n        order by m.id\n        ",
