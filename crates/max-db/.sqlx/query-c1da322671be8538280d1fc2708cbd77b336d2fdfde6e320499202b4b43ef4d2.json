{
  "db_name": "PostgreSQL",
  "query": "\n        select m.id as \"id!\", m.received_at as \"received_at!\", mm.ordinal as \"ordinal?\",\n               md.model_sha256 as \"model_sha256?\"\n        from messages m\n        left join message_media mm on mm.message_id = m.id\n        left join media md on md.sha256 = mm.sha256\n        where m.id = any($1)\n        ",
