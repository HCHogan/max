  "db_name": "PostgreSQL",
  "query": "\n        select m.conversation_id, m.nodes as \"nodes: Json<Vec<Node>>\", md.sha256, md.mime, md.size\n        from messages m\n        join message_media mm on mm.message_id = m.id\n        join media md on md.sha256 = mm.sha256\n        where m.id = $1 and mm.ordinal = $2\n        ",
